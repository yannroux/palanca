<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The chiseled runtime image ships no ICU data; timestamps are stored and shown in UTC. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <!-- Needed only by `dotnet ef` at design time, so Release builds and the image leave it out. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Palanca.Tests" />
  </ItemGroup>

</Project>
