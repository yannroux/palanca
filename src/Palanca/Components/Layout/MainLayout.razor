@inherits LayoutComponentBase
@inject NavigationManager Navigation

<header class="board-bar">
    <a class="board-home" href="/"><Wordmark /></a>
    <nav class="board-nav" aria-label="Main">
        <a href="/" class="@Active(Section.Applications)" aria-current="@Current(Section.Applications)">Applications</a>
        <a href="/history" class="@Active(Section.History)" aria-current="@Current(Section.History)">History</a>
        <a href="/tokens" class="@Active(Section.Tokens)" aria-current="@Current(Section.Tokens)">Tokens</a>
        <a href="/passkeys" class="@Active(Section.Passkeys)" aria-current="@Current(Section.Passkeys)">Passkeys</a>
    </nav>
    <div class="board-owner">
        <SectionOutlet SectionName="@BoardContext" />
        <span class="board-owner-email">@HttpContext.User.Identity?.Name</span>
        <form method="post" action="/sign-out">
            <AntiforgeryToken />
            <button type="submit" class="board-sign-out"><Icon Name="sign-out" />Sign out</button>
        </form>
    </div>
</header>
<main class="page" id="main">
    @Body
</main>

@code {
    /// <summary>The header slot an application page fills with its application switcher.</summary>
    public const string BoardContext = "board-context";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    private enum Section
    {
        Applications,
        History,
        Tokens,
        Passkeys,
    }

    private Section CurrentSection
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            return path switch
            {
                "/history" => Section.History,
                "/tokens" => Section.Tokens,
                "/passkeys" => Section.Passkeys,
                _ => Section.Applications,
            };
        }
    }

    private string? Active(Section section) => CurrentSection == section ? "active" : null;

    private string? Current(Section section) => CurrentSection == section ? "page" : null;
}
