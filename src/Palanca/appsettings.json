{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Palanca": {
    "Database": {
      "FilePath": "/data/palanca.db",
      "BackupDirectory": "/data/backups"
    },
    "Dashboard": {
      "Origin": "https://palanca.hogarhero.com"
    },
    "DataProtection": {
      "KeysDirectory": "/data/keys"
    },
    "Network": {
      "TrustedProxies": []
    }
  }
}
