<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Palanca.Client</PackageId>
    <!-- Releases set the version from their client-v<version> tag; other builds pack as a development version. -->
    <Version>0.0.0-dev</Version>
    <Authors>Yann Roux</Authors>
    <Description>Client for Palanca, a self-hosted on/off feature flag service. Serves flags from memory, polls for changes, and falls back to code defaults, so the flag service never takes the application down.</Description>
    <PackageTags>feature-flags;feature-toggles;palanca</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yannroux/palanca</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Source Link comes with the SDK; these put the repository and any generated sources in the package. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Only Microsoft.Extensions packages, so a worker service without ASP.NET Core can use the client too. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Palanca.Client.Tests" />
    <InternalsVisibleTo Include="Palanca.Tests" />
  </ItemGroup>

</Project>
