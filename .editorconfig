root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,slnx}]
indent_size = 2

[src/Palanca/Data/Migrations/*.cs]
# EF Core emits short-lived array literals for schema metadata. They run once,
# during migration, not in a hot path.
dotnet_diagnostic.CA1861.severity = none
